version: "3.9"

services:
  minio:
    image: minio/minio:RELEASE.2026-02-15T00-00-00Z
    container_name: minio
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: {{ minio_username }}
      MINIO_ROOT_PASSWORD: {{ minio_password }}
    volumes:
      - /srv/minio/data:/data
      - /srv/minio/config:/root/.minio
    command: server /data
    ports:
      - "9000:9000"
      - "9001:9001"
